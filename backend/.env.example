APP_NAME=Mesa Quant Master
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
API_DOCS_ENABLED=true
DATABASE_URL=sqlite:///./mesa_quant_master.db
SECRET_KEY=change-me-in-local-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000
MAX_REQUEST_BODY_BYTES=2097152
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BRAPI_BASE_URL=https://brapi.dev
BRAPI_API_KEY=
BRAPI_TIMEOUT_SECONDS=10
BRAPI_QUOTE_CACHE_SECONDS=60
BRAPI_SEARCH_CACHE_SECONDS=600
BRAPI_PROFILE_CACHE_SECONDS=3600
TESOURO_TRANSPARENTE_DATASET_URL=https://www.tesourotransparente.gov.br/ckan/dataset/df56aa42-484a-4a59-8184-7676580c81e3/resource/796d2059-14e9-44e3-80c9-2d9e30b405c1/download/precotaxatesourodireto.csv
TESOURO_TRANSPARENTE_CACHE_DIR=.cache/tesouro_transparente
TESOURO_TRANSPARENTE_TIMEOUT_SECONDS=30
TESOURO_TRANSPARENTE_MAX_DOWNLOAD_BYTES=41943040
TESOURO_TRANSPARENTE_CACHE_TTL_HOURS=6
CVM_CACHE_DIR=.cache/cvm
CVM_TIMEOUT_SECONDS=60
CVM_MAX_DOWNLOAD_BYTES=83886080
CVM_MAX_UNCOMPRESSED_BYTES=1073741824
CVM_CACHE_TTL_HOURS=24
CVM_FII_CACHE_DIR=.cache/cvm_fii
CVM_FII_TIMEOUT_SECONDS=60
CVM_FII_MAX_DOWNLOAD_BYTES=41943040
CVM_FII_MAX_UNCOMPRESSED_BYTES=536870912
CVM_FII_CACHE_TTL_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Mesa Quant Master
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
FRONTEND_PUBLIC_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_EMAIL_REQUEST_COOLDOWN_SECONDS=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_AGENT_ENABLED=false
AI_AGENT_TIMEOUT_SECONDS=30
AI_AGENT_MAX_ITERATIONS=6
